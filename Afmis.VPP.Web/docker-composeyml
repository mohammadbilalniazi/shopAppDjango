services:
  backend:
    image: mohammadbilal123/tpms:v3  # v3 is for redis and dockerignore
    container_name: tpms-backend
    restart: unless-stopped
    ports:
      - "5000:5000"
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_URLS: http://+:5000
      USE_ENCRYPTION: "false"

      # Redis connection string for .NET (double __ => :)
      Redis__Connection: "redis:6379,password=Allahisone1,abortConnect=false,ssl=False,defaultDatabase=0"

      # ConnectionStrings overrides
      ConnectionStrings__Server: "zkXLtkDhAe5rlTQF6Xw4MQ=="
      ConnectionStrings__Database: "rX7EZdNk2eNmrfxs6k4/8G81lo/4AKuYG0myspPisf4="
      ConnectionStrings__UserId: "dmp1+e1ASveofdaq9jPLzw=="
      ConnectionStrings__Password: "thAnP4mvsEKfI1//0DtNQQ=="
      ConnectionStrings__Trusted_Connection: "false"
      ConnectionStrings__MultipleActiveResultSets: "true"
      ConnectionStrings__Encrypt: "false"
      ConnectionStrings__TrustServerCertificate: "true"
      ConnectionStrings__Timeout: "800"

      # HRIntegrationDBContext overrides
      HRIntegrationDBContext__Server: "zkXLtkDhAe5rlTQF6Xw4MQ=="
      HRIntegrationDBContext__Database: "RVQqEGqtISPTG0xp7qCRSdlsRBa3Cr9lGg1purZ+aTc="
      HRIntegrationDBContext__UserId: "KFJRhxW8Y1/NSvBdds5IiQ=="
      HRIntegrationDBContext__Password: "thAnP4mvsEKfI1//0DtNQQ=="
      HRIntegrationDBContext__Trusted_Connection: "false"
      HRIntegrationDBContext__MultipleActiveResultSets: "true"
      HRIntegrationDBContext__Encrypt: "false"
      HRIntegrationDBContext__TrustServerCertificate: "true"
      HRIntegrationDBContext__Timeout: "800"

      # JWT
      JwtConfig__SigningKey: "yZPEXjzkq0AWYCsDf9Qe5mCX3OEYP/DfXD2RRBOP9M65cZi6oYcYz1b62zEsumMZ1FcgoDVBUJy5Dpf7ikIYbg=="
      JwtConfig__Issuer: "http://192.168.5.19:8080/api/v1/Authentications/Login"
      JwtConfig__Audience: "http://192.168.5.19:80/"

      # CORS
      CorsConfig__AllowedSubnetsCORS__0: "0.0.0.0/0"

      TZ: "Asia/Kabul"
    depends_on:
      - redis
    networks:
      - afmis-net

  redis:
    image: redis:7-alpine
    container_name: tpms-redis
    command: ["redis-server", "--appendonly", "yes", "--requirepass", "Allahisone1"]
    environment:
      TZ: "Asia/Kabul"
    volumes:
      - redis-data:/data
    # Expose only if you need host access for debugging
    ports:
      - "6379:6379"
    restart: unless-stopped
    networks:
      - afmis-net
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "Allahisone1", "PING"]
      interval: 10s
      timeout: 3s
      retries: 5

  # optional visual UI for debugging
  redisinsight:
    image: redis/redisinsight:latest
    container_name: redisinsight
    ports:
      - "5540:5540"
    depends_on:
      - redis
    restart: unless-stopped
    networks:
      - afmis-net

  frontend:
    build:
      context: ./Afmis.VPP.Web
      dockerfile: Dockerfile
    image: mohammadbilal123/tpmsfront:v3 # v3 is for redis and dockerignore
    container_name: tpms-frontend
    ports:
      - "3000:80"
    depends_on:
      - backend
    restart: unless-stopped
    networks:
      - afmis-net

volumes:
  redis-data:

networks:
  afmis-net:
    driver: bridge
